<?xml version="1.0" encoding="utf-8"?>
<!-- NAV-021 AC 3 / R4, R5 (debug build only; the release APK contains 0 classes or entry points of this path): the
     developer command for a local routing file and the on-device benchmark. Senders need android.permission.DUMP,
     which `adb shell` has and normal apps cannot get. See mobile/android/README.md "On-device routing (NAV-021)". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="mn.navmn.app.routing.debug.RoutingDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="mn.navmn.app.debug.ROUTING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
