# Static public demo (NAV-002 section M, AC 51–54; PO decision D44). Read only by `npm run build:static-demo`
# (Vite mode "static-demo"). It overrides .env and .env.local; a .env.static-demo.local would override it.
# No hostnames here (D35): the build works on any host.

# Tiles from the page's own origin: <origin>/tiles/basemap.pmtiles.
VITE_GATEWAY_BASE_URL=same-origin

# Map only: search, reverse and routing are off, with 0 requests (AC 53, AC 54).
VITE_STATIC_DEMO=true

# The public site never contains demo mode (NAV-017 AC 4): explicit, so a local .env can never turn it on here.
VITE_DEMO_MODE=false
