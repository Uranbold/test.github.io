# NAV-017 demo-mode build (ADR-0011 §2). Read only by `npm run build:demo-mode` (Vite mode "demo-mode"); it overrides
# .env and .env.local. A git-ignored .env.demo-mode.local would override it. No hostnames or folder names here (D35):
# the build works from any sub-folder of any host.

# Map only: search, reverse and routing are off, with 0 requests (demo mode requires this).
VITE_STATIC_DEMO=true

# Tiles from the public archive at the page origin: <origin>/tiles/basemap.pmtiles, outside the protected folder
# (ADR-0011 §4).
VITE_GATEWAY_BASE_URL=same-origin

# Demo mode on: route picker and simulated turn-by-turn replay of the recorded routes (NAV-017).
VITE_DEMO_MODE=true
