# Web demo configuration (copy to .env and edit). Vite reads these at start-up and bakes them into the build.
# Never put real hostnames or keys in committed files (D35); use placeholders such as https://<demo-host>.

# Gateway base URL (NAV-001 stack). Tiles are read from <base>/tiles/basemap.pmtiles; trailing slashes are ignored.
#   unset or empty      -> http://localhost:8080 (normal builds) or the page origin (static demo)
#   same-origin  or  /  -> the page's own origin at runtime (window.location.origin), so one build works on any host
#   /some/path          -> the page origin plus that path
#   https://<gateway>   -> that absolute URL
VITE_GATEWAY_BASE_URL=http://localhost:8080

# Static public demo (NAV-002 AC 53-54, D44): "true" turns search, reverse and routing off with 0 requests; the search
# box shows «Хайлт түр ажиллахгүй байна» with «Дахин оролдох». "false" or unset = normal build. Any other value fails
# the build. `npm run build:static-demo` sets it (see .env.static-demo); leave it false here.
VITE_STATIC_DEMO=false

# NAV-017 demo mode (ADR-0011): "true" builds the route picker and the simulated turn-by-turn replay of the recorded
# Ulaanbaatar routes, for the password-protected demo folder only. Requires VITE_STATIC_DEMO=true; any other value
# than true/1/false/0 fails the build. `npm run build:demo-mode` sets it (see .env.demo-mode); leave it false here.
VITE_DEMO_MODE=false
