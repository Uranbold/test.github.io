# NAV-001 gateway server (ADR-0002 §2-3, docs/architecture/api/openapi.yaml).
# Rendered by the nginx image's envsubst step: only ${VALHALLA_UPSTREAM}, ${PHOTON_UPSTREAM} and
# ${GATEWAY_ERROR_LOG_LEVEL} are substituted; nginx's own $variables are left alone.
#
# NAV-006 (ADR-0014 §3): upstreams and the tiles file come from njs (gateway/njs/slot.js), which reads the
# slot pointer /etc/nginx/slot/active.json on every request when that directory is mounted
# (backend/compose.slots.yaml). Without it (backend/compose.yaml, dev) the NAV-001 values below are used.
#
#   GET  /health                   -> answered here
#   GET  /tiles/basemap.pmtiles    -> static file, HTTP Range / ETag (416 = JSON RangeNotSatisfiable)
#   POST /v1/route, GET ?json=     -> Valhalla /route   (pass-through)
#   GET  /v1/search                -> Photon /api       (pass-through)
#   GET  /v1/reverse               -> Photon /reverse   (pass-through)
#   GET  /packs/mn/manifest.json   -> static file (NAV-020, openapi 0.6.0 getOfflinePackManifest): no-cache, ETag
#   GET  /packs/mn/<v>/<file>.gz   -> static file (getOfflinePackFile): Range/If-Range, ETag, immutable
#   OPTIONS <any path>             -> 204 CORS preflight, never forwarded
#
# Rate limits (NAV-008, off in dev): conf.d/01-rate-limits.conf, generated by
# entrypoint/16-rate-limits.sh, applies limit_req to ROUTE, SEARCH+REVERSE and (NAV-020) PACKS only. Rejected
# requests (429) go to @rate_limited. HEALTH, TILES and every OPTIONS preflight are never request-rate limited
# (TILES gets only the SEC-4A bandwidth limit after an initial burst, below).
#
# SEC-2 (ADR-0019, openapi 0.7.0), ROUTE only:
#   - Concurrency cap, always on: conf.d/02-route-limits.conf (entrypoint/17-route-limits.sh) applies limit_conn
#     (global GATEWAY_ROUTE_MAX_INFLIGHT, per client IP GATEWAY_ROUTE_MAX_INFLIGHT_PER_IP) to /v1/route GET/POST.
#     A rejected request gets the private status 529 -> @route_busy = 503 RoutingBusy (Retry-After, no-store).
#     The ROUTE location reads $nav_rc_ip_key, so nginx refuses to start when that file is missing (the cap can
#     never be silently off).
#   - proxy_intercept_errors on: a Valhalla 5xx (including its own 504 after VALHALLA_TIMEOUT_SECONDS, a plain-text
#     body) is answered with the gateway's JSON GatewayError, never passed through raw. There is deliberately NO
#     error_page 400 here: Valhalla's 400 bodies (DistanceExceeded, InvalidValue, NoSegment, ...) pass through.
#
# SEC-4A:
#   - BE-2: every per-IP limit (limit_req zones, the SEC-2 per-IP cap, the download limits) is keyed on $nav_client_key
#     (nginx.conf, gateway/njs/client.js): IPv4 by full address, IPv6 by its /64 prefix.
#   - BE-3: download limits, conf.d/03-download-limits.conf (entrypoint/18-download-limits.sh), only with
#     GATEWAY_RATE_LIMIT=on: PACKS per-client and global limit_conn (over it: 429 RateLimited), and on PACKS and TILES a
#     per-response limit_rate after an initial burst (Range requests keep working; tile reads are below the burst).
#     TILES: per-client cap on requests in flight, GET and HEAD alike (GATEWAY_TILES_MAX_CONN_PER_IP, default 32,
#     never below 24, 0 = off; openapi 0.7.1 / ADR-0019 Amendment 1): over it 429 RateLimited (headers only on HEAD).
#     It is a connection cap, not a request rate: tile reads at any rate stay unlimited (NAV-008 AC 13). The TILES
#     and PACKS locations read $nav_dl_loaded (defined only in that file), so nginx refuses to start when it is missing.
#   - BE-13: X-Content-Type-Options: nosniff on every response (snippets/cors-headers.conf, which every location
#     includes; the 416 keeps the TILES/PACKS location's copy, as for the CORS headers).
#
# SEC BE-14 (checklist B7/B10): edge timeouts and buffers are set once in nginx.conf (http level). Request bodies:
#   1 KB everywhere (nginx.conf; a body on a GET/HEAD/OPTIONS path is useless) and 256 KB on /v1/route (the
#   openapi GatewayPayloadTooLarge contract), both answered as JSON 413 PayloadTooLarge; every static location
#   re-declares error_page 413 because declaring any error_page stops inheriting the server-level ones.
#   /v1/route also carries explicit client_body_timeout / send_timeout (threat model 1.11: a slow reader must not
#   hold a SEC-2 cap slot). TILES and PACKS accept a single Range (max_ranges 1): a multi-range request is served
#   as the whole file and counted by the connection caps like one.

# nginx error_log lines contain the request line (query string = coordinates / search text).
# Keep the level at crit unless you are debugging locally (ADR-0002 §3.4).
error_log /dev/stderr ${GATEWAY_ERROR_LOG_LEVEL};

# Docker's embedded DNS + variable proxy_pass: nginx starts and keeps running while an
# upstream container is stopped, and fails fast (502) instead of hanging (AC 34).
resolver 127.0.0.11 valid=10s ipv6=off;

js_import slot from slot.js;
js_set $valhalla_upstream slot.valhalla;
js_set $photon_upstream   slot.photon;
js_set $nav_tiles_path    slot.tiles;
resolver_timeout 2s;

# A stopped upstream whose IP is still in the resolver cache gives a *connect* timeout, which
# nginx reports as 504. The contract wants 502/503 for "unavailable" (AC 34) and 504 only when
# the upstream accepted the connection but did not answer in time. "-" = connect never completed.
map $upstream_connect_time $upstream_connect_failed {
    ""      1;
    "-"     1;
    default 0;
}

# nginx sends Accept-Ranges on full 200 responses only; the contract also lists it on 206.
# add_header runs before the range filter sets 206, so key on the request's Range header.
map $http_range $tiles_accept_ranges_206 {
    ""      "";
    default bytes;
}

server {
    listen 8080 default_server;
    server_name _;

    # Dev-mode defaults, read by slot.js only when no slot pointer directory is mounted.
    set $nav_dev_valhalla ${VALHALLA_UPSTREAM};
    set $nav_dev_photon   ${PHOTON_UPSTREAM};

    error_page 404 = @not_found;
    error_page 405 = @method_not_allowed;
    error_page 413 = @payload_too_large;

    # ---------------------------------------------------------------- HEALTH
    location = /health {
        include /etc/nginx/snippets/cors-headers.conf;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # ---------------------------------------------------------------- TILES
    location = /tiles/basemap.pmtiles {
        include /etc/nginx/snippets/cors-headers.conf;
        add_header Cache-Control "public, max-age=300";
        add_header Accept-Ranges $tiles_accept_ranges_206;
        # SEC-4A BE-3 guard: unknown variable (nginx -t fails) unless 18-download-limits.sh wrote 03-download-limits.conf.
        set $nav_dl_guard $nav_dl_loaded;
        # GATEWAY_TILES_MAX_CONN_PER_IP (default 32; 0 = off): over the cap -> 429 RateLimited (not the SEC-2 529).
        limit_conn_status 429;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        gzip off;
        etag on;
        max_ranges 1;
        types { }
        default_type application/octet-stream;
        # Dev: /srv/data/tiles/basemap.pmtiles. Slot mode: /srv/slots/<slot>/tiles/basemap.pmtiles of the
        # active pointer. The ETag ("<mtime>-<size>") changes with the archive, so pmtiles clients re-read
        # the header after a switch (ADR-0014 §5). No open_file_cache: every request opens the current file.
        alias $nav_tiles_path;
        # NAV-001 AC 43 (ADR-0002 Amendment 2). An unsatisfiable Range makes the range filter turn
        # the 200 into a 416 *after* the header filter has already added the CORS headers above,
        # so the 416 target must not add them again. A location that declares any error_page stops
        # inheriting the server-level ones, so 404/405 are re-declared here (missing archive = JSON 404).
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        error_page 416 = @range_not_satisfiable;
        error_page 429 = @rate_limited;
    }

    # ---------------------------------------------------------------- ROUTE
    location = /v1/route {
        include /etc/nginx/snippets/cors-headers.conf;
        # SEC-2 guard: unknown variable (nginx -t fails) unless 17-route-limits.sh wrote 02-route-limits.conf.
        set $nav_rc_guard $nav_rc_ip_key;
        error_page 429 = @rate_limited;
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        # Upstream 500/502/503 -> 502 UpstreamUnavailable. The gateway's own cap never uses 503 (private 529).
        error_page 500 502 503 = @route_unavailable;
        error_page 504 = @route_timeout;
        error_page 529 = @route_busy;
        # NEVER add error_page 400 here (Valhalla's 400 bodies are the contract).
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        # openapi GatewayPayloadTooLarge: "Request body over 256 KB" (the only location that accepts a body).
        client_max_body_size 256k;
        # SEC BE-14 / threat model 1.11: explicit per-location timeouts on the only capped path (same values as
        # nginx.conf, repeated here so the cap's bound is visible next to the cap).
        client_body_timeout 10s;
        send_timeout        10s;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_intercept_errors on;
        proxy_read_timeout 10s;
        proxy_pass http://$valhalla_upstream/route$is_args$args;
    }

    # ---------------------------------------------------------------- SEARCH
    location = /v1/search {
        include /etc/nginx/snippets/cors-headers.conf;
        error_page 429 = @rate_limited;
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        error_page 502 503 = @search_unavailable;
        error_page 504 = @search_timeout;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 5s;
        proxy_pass http://$photon_upstream/api$is_args$args;
    }

    # ---------------------------------------------------------------- REVERSE
    location = /v1/reverse {
        include /etc/nginx/snippets/cors-headers.conf;
        error_page 429 = @rate_limited;
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        error_page 502 503 = @search_unavailable;
        error_page 504 = @search_timeout;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 5s;
        proxy_pass http://$photon_upstream/reverse$is_args$args;
    }

    # ---------------------------------------------------------------- PACKS (NAV-020, ADR-0017 §5-§6)
    # Static files written by the pack step under NAV_DATA_ROOT/packs (compose.slots.yaml mounts it read-only at
    # /srv/packs; the dev compose.yaml does not, so every /packs/ path is a JSON 404 there). Only the two openapi
    # shapes are served: region mn, fileVersion = slot ID, file = one of the three names. Everything else under
    # /packs/ (other regions, dot files such as .manifests/ and .history.json, *.partial, .work/) falls through
    # to `location /` = JSON 404. gzip is off in both: the manifest needs a strong ETag (nginx weakens it when
    # compressing) and the pack files are gzip files themselves (no Content-Encoding, byte-exact ranges).
    # No open_file_cache: a renamed manifest is served on the next request; its ETag ("<mtime>-<size>") changes
    # because the writer always gives the new file a newer mtime (ADR-0017 A1 item 11).
    location = /packs/mn/manifest.json {
        include /etc/nginx/snippets/cors-headers.conf;
        add_header Cache-Control "no-cache";
        # SEC-4A BE-3: guard + the download connection limits answer 429 RateLimited here (see header).
        set $nav_dl_guard $nav_dl_loaded;
        limit_conn_status 429;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        gzip off;
        etag on;
        types { }
        default_type application/json;
        alias /srv/packs/mn/manifest.json;
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        error_page 429 = @rate_limited;
    }
    # Named captures: the regex in the `if` below would overwrite numbered ones.
    location ~ "^/packs/mn/(?<nav_pack_version>[0-9]{8}T[0-9]{6}Z)/(?<nav_pack_file>basemap\.pmtiles|routing\.tar|search\.sqlite)\.gz$" {
        include /etc/nginx/snippets/cors-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Accept-Ranges $tiles_accept_ranges_206;
        set $nav_dl_guard $nav_dl_loaded;
        limit_conn_status 429;
        if ($request_method = OPTIONS) { return 204; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        gzip off;
        etag on;
        max_ranges 1;
        types { }
        default_type application/octet-stream;
        alias /srv/packs/mn/$nav_pack_version/$nav_pack_file.gz;
        # 416 as in TILES (njs: Cache-Control no-store, no Accept-Ranges); a retired file is a JSON 404.
        error_page 404 = @not_found;
        error_page 405 = @method_not_allowed;
        error_page 413 = @payload_too_large;
        error_page 416 = @range_not_satisfiable;
        error_page 429 = @rate_limited;
    }

    # ---------------------------------------------------------------- everything else
    location / {
        include /etc/nginx/snippets/cors-headers.conf;
        if ($request_method = OPTIONS) { return 204; }
        return 404;
    }

    # ---------------------------------------------------------------- JSON error bodies (GatewayError)
    location @not_found {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        return 404 '{"code":"NotFound","message":"No such endpoint"}';
    }
    location @method_not_allowed {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        return 405 '{"code":"MethodNotAllowed","message":"Method not allowed"}';
    }
    # Target of the TILES location only. No cors-headers.conf on purpose: the TILES location's
    # headers survive the internal redirect, and including the snippet here duplicates every
    # Access-Control-* header (browsers then reject the response as a CORS error).
    # The file's Cache-Control/Accept-Ranges survive too; the njs filter turns them into
    # "Cache-Control: no-store" and no Accept-Ranges (the error must not be cached).
    location @range_not_satisfiable {
        js_header_filter headers.range416;
        default_type application/json;
        return 416 '{"code":"RangeNotSatisfiable","message":"Requested range not satisfiable"}';
    }
    # NAV-008 AC 13 (openapi 0.4.0 RateLimited). limit_req rejects in the preaccess phase, before any
    # header filter has run, so the CORS snippet here adds each Access-Control-* header exactly once.
    # Retry-After is 1 s: at the configured rates (>= 1 r/s) a new request is accepted after 1 s.
    location @rate_limited {
        include /etc/nginx/snippets/cors-headers.conf;
        add_header Retry-After   1 always;
        add_header Cache-Control no-store always;
        default_type application/json;
        return 429 '{"code":"RateLimited","message":"Too many requests"}';
    }
    location @payload_too_large {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        return 413 '{"code":"PayloadTooLarge","message":"Request body too large"}';
    }
    location @route_unavailable {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        return 502 '{"code":"UpstreamUnavailable","message":"routing service unavailable"}';
    }
    # SEC-2 (NAV-001 AC 49, openapi RoutingBusy). limit_conn rejects in the preaccess phase, before any header
    # filter has run (as limit_req for @rate_limited), so the CORS snippet adds each Access-Control-* header once.
    # Retry-After 1: a slot frees as soon as one route request in flight finishes (they are bounded by the timeouts).
    location @route_busy {
        include /etc/nginx/snippets/cors-headers.conf;
        add_header Retry-After   1 always;
        add_header Cache-Control no-store always;
        default_type application/json;
        return 503 '{"code":"RoutingBusy","message":"routing service busy"}';
    }
    # Gateway read timeout (10 s) and, since SEC-2, Valhalla's own 504 after VALHALLA_TIMEOUT_SECONDS (intercepted).
    location @route_timeout {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        if ($upstream_connect_failed) {
            return 502 '{"code":"UpstreamUnavailable","message":"routing service unavailable"}';
        }
        return 504 '{"code":"UpstreamTimeout","message":"routing service timed out"}';
    }
    location @search_unavailable {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        return 502 '{"code":"UpstreamUnavailable","message":"search service unavailable"}';
    }
    location @search_timeout {
        include /etc/nginx/snippets/cors-headers.conf;
        default_type application/json;
        if ($upstream_connect_failed) {
            return 502 '{"code":"UpstreamUnavailable","message":"search service unavailable"}';
        }
        return 504 '{"code":"UpstreamTimeout","message":"search service timed out"}';
    }
}
