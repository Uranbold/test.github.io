# NAV-006 dev-container TEST configuration (D126, AC 35-37). Rendered by backend/pipeline/test-setup.sh into
# <test root>/nav006.env (outside git). @ROOT@ = the test root. Never use this file on staging: staging keys
# and defaults are in infra/staging/.env.example. Every relaxation below is logged by every run (AC 37).

# Compose project of the test stack. Must NOT be navmn (the shared dev stack); the pipeline refuses projects
# whose containers come from backend/compose.yaml.
NAV_COMPOSE_PROJECT=navmn-nav006
# Slot root of the test (cache, slots, lanes, pointer, state, runs). Same filesystem as backend/data (hard links).
NAV_DATA_ROOT=@ROOT@/data
# Lock of the test project (staging: /run/lock/nav-stack.lock, shared with deploy.sh and cert-dry-run.sh).
NAV_LOCK_FILE=@ROOT@/nav-stack.lock
# Public test gateway, 127.0.0.1 only (the shared dev gateway is 8080).
GATEWAY_PORT=18080
# Private verify gateway, 127.0.0.1 only.
NAV_VERIFY_PORT=18089

# Ordered OSM source list (AC 2, AC 36): a copy of the cached Mongolia extract. Append
# https://geo2day.com/asia/mongolia.pbf (dev mirror) or put a blocked URL first to see the fallback.
OSM_SOURCES=file:@ROOT@/input/mongolia.osm.pbf
# Photon dump: a copy of the cached GraphHopper Mongolia dump (no download).
PHOTON_DUMP_FILE=@ROOT@/input/photon-dump.jsonl.zst

# RELAXED (AC 37): the cached extract is older than 48 h, so freshness 3(f) is off (0 = disabled).
REBUILD_MAX_DATA_AGE_HOURS=0
# Kept ON: the same file has the same data date, which is "not older" (3(e) passes).
REBUILD_REQUIRE_NOT_OLDER=1
# RELAXED (ADR-0014 §7): this container has about 8.6 GB free; staging requires 50.
REBUILD_MIN_FREE_GB=4
# RELAXED (ADR-0014 §7): staging hard floor during the build is 5 GB.
REBUILD_HARD_FLOOR_FREE_GB=1
# Staging value; this container has about 14 GB available.
REBUILD_MIN_MEM_AVAILABLE_GB=6.5
# Grace period before the old lane stops (AC 17, minimum 30).
REBUILD_GRACE_SECONDS=30
# Alert hook placeholder: appends one line per qualifying run (single quotes: no Compose interpolation).
REBUILD_ALERT_CMD='echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) run=$NAV_RUN_ID result=$NAV_RUN_RESULT step=$NAV_RUN_STEP exit=$NAV_RUN_EXIT_CODE" >> @ROOT@/alerts.log'
# Test-only fault injection (QA set item 2). Honoured only with REBUILD_ALLOW_TEST_FAULTS=1 and a project other
# than navmn. Set REBUILD_TEST_FAULT=validate|build|verify|post_switch in the environment of one command.
REBUILD_ALLOW_TEST_FAULTS=1
