# NAV-020 dev-container TEST configuration (AC 29-32; task file B17). Rendered by backend/pipeline/nav020-test-setup.sh
# into <test root>/nav020.env (outside git). @ROOT@ = the test root. Never use this file on staging: staging keys and
# defaults are in infra/staging/.env.example. Every relaxation below is logged by every pack step.

# Compose project of the test stack. Must NOT be navmn (shared dev stack) or navmn-nav006 (NAV-006 test).
NAV_COMPOSE_PROJECT=navmn-nav020
# Slot root of the test (slots, lanes, pointer, state, runs, packs). Same filesystem as backend/data.
NAV_DATA_ROOT=@ROOT@/data
# Lock of the test project (staging: /run/lock/nav-stack.lock).
NAV_LOCK_FILE=@ROOT@/nav-stack.lock
# Public test gateway, 127.0.0.1 only. Not 8080 (shared dev stack), 18080/18089 (NAV-006 test) or 18089-18092
# (infra/ci/backend-static-checks.sh containers), so the static checks can run while this stack is up.
GATEWAY_PORT=18190
# Private verify gateway, 127.0.0.1 only (not started by the pack tests).
NAV_VERIFY_PORT=18199
# Rate limits ON in the test gateway (AC 21). Route/search at the staging values; packs high enough for the AC 14 read
# loop (>= 10 r/s); the AC 21 check recreates the gateway with GATEWAY_RATE_PACKS=1r/s GATEWAY_BURST_PACKS=3.
GATEWAY_RATE_LIMIT=on
# Per-IP packs rate for the main test runs.
GATEWAY_RATE_PACKS=50r/s
# Per-IP packs burst for the main test runs.
GATEWAY_BURST_PACKS=100
# CORS of the test gateway (the contract check sends Origin: http://localhost:5173).
CORS_ALLOWED_ORIGINS=*
# Smaller test lanes (the dev container shares its RAM with the shared stack and parallel Android builds).
PHOTON_JAVA_OPTS=-Xms128m -Xmx512m
# Valhalla worker threads of the test lanes.
VALHALLA_THREADS=2

# NAV-006 keys the pipeline's configuration requires (no rebuild runs in this test; slots are seeded).
OSM_SOURCES=file:@ROOT@/input/mongolia.osm.pbf
# Photon dump of the seeded slots (a copy of the dev stack's dump).
PHOTON_DUMP_FILE=@ROOT@/input/photon-dump.jsonl.zst
# RELAXED: the cached extract is older than 48 h (status shows stale; not used by the pack step).
REBUILD_MAX_DATA_AGE_HOURS=0
# Grace period (NAV-006 minimum 30; used by make rollback in the AC 28 test).
REBUILD_GRACE_SECONDS=30
# Alert hook placeholder: appends one line per call (single quotes: no Compose interpolation).
REBUILD_ALERT_CMD='echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) run=$NAV_RUN_ID result=$NAV_RUN_RESULT step=$NAV_RUN_STEP exit=$NAV_RUN_EXIT_CODE" >> @ROOT@/alerts.log'
# Test-only switches (PACK_GATE2_MODE=evidence, PACK_TEST_FAULT, PACK_TEST_PAUSE_AT) need this and a project other than navmn.
REBUILD_ALLOW_TEST_FAULTS=1

# ---------------------------------------------------------------- NAV-020 pack step
# On (the hook after a NAV-006 success; make pack-publish works either way).
PACK_ENABLED=1
# RELAXED (AC 16 test configuration): weekly part due at every run (staging 7).
PACK_WEEKLY_MIN_AGE_DAYS=0
# Staging value, so a weekly cut keeps the older tiles (AC 31); the AC 16 run sets 0 in its environment.
PACK_TILES_MIN_AGE_DAYS=28
# RELAXED: this container has well under 2 GB free (staging 2); the AC 18 test sets 999 in its environment.
PACK_MIN_FREE_GB=0.2
# Retained manifests (AC 16).
PACK_RETAIN_MANIFESTS=3
# TEST ONLY: the Gate 2 engine image is not built here (6-12 GB build, task file §4.3). Evidence mode runs the server's
# own Valhalla library on both sides: it exercises the runner and comparator, it is NOT the gate (AC 35).
PACK_GATE2_MODE=evidence
# The QA golden route set does not exist yet; the backend's provisional copy (same AC 9 requests).
PACK_GATE2_GOLDEN_SET=backend/pack/golden-routes.provisional.json
# Placeholder public pipeline repository for the manifest (the real value is configuration, AC 34).
PACK_METHOD_URL=https://example.org/osm-navigation/pipeline
