# NAV-001 local dev stack (staging overrides: infra/staging/.env.example). Copy to .env (`cp .env.example .env`) and edit.
# Every key is optional: compose.yaml has the same defaults. No secrets belong in this file.
# Relative paths are relative to backend/ (the directory that holds compose.yaml).

# ---------------------------------------------------------------- OSM source (tiles + routing)
# OSM extract to download (NAV-001 AC 3, ADR-0002 Amendment 1), https:// only (SEC-4A BE-7: downloads never follow a
# redirect to http). Default: all of Mongolia from Geofabrik (~70 MB, header bbox and replication timestamp), the
# same source as staging. Where Geofabrik is blocked (the agent dev container), download the PBF by any other route
# and set OSM_PBF_FILE; a third-party mirror is no longer a default (SEC-4A, integrity).
OSM_PBF_URL=https://download.geofabrik.de/asia/mongolia-latest.osm.pbf
# Optional small/fast alternative, NOT the default: BBBike Ulaanbaatar box (~4.4 MB, ~13 x 4 km).
# It misses reference points P3 Zaisan and P6 Chingeltei, so NAV-001 AC 10/13/14 fail on it.
# OSM_PBF_URL=https://download.bbbike.org/osm/bbbike/UlanBator/UlanBator.osm.pbf
# Optional local PBF file. When set, it is used instead of OSM_PBF_URL and no request is made to the URL.
OSM_PBF_FILE=

# ---------------------------------------------------------------- Photon search index (ADR-0003)
# Photon JSON dump to import (GraphHopper weekly Mongolia dump, .jsonl.zst or plain .jsonl), https:// only.
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/asia/mongolia/photon-dump-mongolia-1.0-latest.jsonl.zst
# Optional local dump file. When set, it is used instead of PHOTON_DUMP_URL and no request is made to the URL.
PHOTON_DUMP_FILE=
# Languages extracted into the index; `lang` accepts only these plus `default`.
PHOTON_LANGUAGES=mn,en,ru
# Optional country filter for the import (comma-separated ISO codes, empty = everything in the dump).
PHOTON_COUNTRY_CODES=
# Language used when a request has no `lang` and no Accept-Language.
PHOTON_DEFAULT_LANGUAGE=mn
# Upper bound for the `limit` parameter.
PHOTON_MAX_RESULTS=20
# JVM options for photon import and serve (heap).
PHOTON_JAVA_OPTS=-Xms256m -Xmx1g

# ---------------------------------------------------------------- Planetiler auxiliary sources (Protomaps basemap)
# Downloaded once into data/sources/ and reused. A file already present there is used without any request.
# Natural Earth vector GeoPackage (public domain, ~446 MB).
NATURAL_EARTH_URL=https://naciscdn.org/naturalearth/packages/natural_earth_vector.gpkg.zip
# OSM water polygons, split, EPSG:3857 (ODbL, ~931 MB).
WATER_POLYGONS_URL=https://osmdata.openstreetmap.de/download/water-polygons-split-3857.zip
# OSM land polygons, split, EPSG:3857 (ODbL, ~952 MB).
LAND_POLYGONS_URL=https://osmdata.openstreetmap.de/download/land-polygons-split-3857.zip
# Daylight landcover GeoPackage hosted by Protomaps (~36 MB).
LANDCOVER_URL=https://r2-public.protomaps.com/datasets/daylight-landcover.gpkg
# Wikidata QRank popularity scores used for label ranking (CC0, ~106 MB).
QRANK_URL=https://qrank.toolforge.org/download/qrank.csv.gz
# Pre-shaped glyph encoding used for complex scripts (~0.8 MB).
PGF_ENCODING_URL=https://wipfli.github.io/pgf-encoding/pgf-encoding.zip

# ---------------------------------------------------------------- Tile build
# Highest zoom level in the PMTiles archive. Default 14 (PO decision 2026-09-30 on NAV-001 AC 12):
# it is the minimum AC 10 needs and keeps the Mongolia archive small. MapLibre overzooms z14 tiles for
# z15+ views. 15 = Protomaps default (the Mongolia build was 243 MB at z0-15). Changing it rebuilds the tiles.
TILES_MAXZOOM=14
# Optional bounds minLon,minLat,maxLon,maxLat. Empty = bbox from the PBF header.
TILES_BOUNDS=
# JVM options for the Planetiler run (heap).
TILES_JAVA_OPTS=-Xmx3g
# Worker threads for Planetiler and the Valhalla graph build (empty = all CPUs).
BUILD_THREADS=

# ---------------------------------------------------------------- Tool downloads (pinned, checksum verified)
# SEC-4A BE-7: every *_SHA256 / *_SHA512 must be set; an empty or malformed value stops data-fetch (fail closed).
# Dev escape hatch only: 1 = a checksum key set to the literal value "skip" is accepted with a warning (staging refuses 1).
ALLOW_UNVERIFIED_TOOLS=0
# Photon release jar and its sha256.
PHOTON_JAR_URL=https://github.com/komoot/photon/releases/download/1.3.0/photon-1.3.0.jar
PHOTON_JAR_SHA256=a89707c0045e4807b2a1180e132e68e108d998709f48b6c94b98a6e281f571a5
# Pure-Java zstd decoder used to stream the .zst Photon dump into the import (Maven Central) and its sha256.
AIRCOMPRESSOR_URL=https://repo1.maven.org/maven2/io/airlift/aircompressor/0.27/aircompressor-0.27.jar
AIRCOMPRESSOR_SHA256=fdbef3137a28f63bb0cb93487803080ede746a4ec3d421e36c6f0c305c35e5e4
# Protomaps basemap git commit (Tiles 4.15.2, Planetiler 0.10.2).
PROTOMAPS_COMMIT=42ffaaa4a85a41bfcb23e43cc0f5b492a5eca123
# Source tarball of that commit (codeload.github.com).
PROTOMAPS_SRC_URL=https://codeload.github.com/protomaps/basemaps/tar.gz/42ffaaa4a85a41bfcb23e43cc0f5b492a5eca123
# sha256 of the Protomaps source tarball.
PROTOMAPS_SRC_SHA256=f89ff8ee6aff13baf60c83b5e98d3811ddb946cc1089d437c435885395764696
# Maven binary distribution used once to build the Protomaps jar, and its sha512.
MAVEN_DIST_URL=https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.9.11/apache-maven-3.9.11-bin.tar.gz
MAVEN_DIST_SHA512=bcfe4fe305c962ace56ac7b5fc7a08b87d5abd8b7e89027ab251069faebee516b0ded8961445d6d91ec1985dfe30f8153268843c89aa392733d1a3ec956c9978

# ---------------------------------------------------------------- Images (pinned tag@sha256; override to use a mirror or a local build)
# SEC-4A BE-8: always tag@sha256:<digest> (infra/ci/backend-static-checks.sh refuses a tag-only image). Re-pin monthly
# and on every security release (README.md "Image pins"), together with an image scan.
# nginx gateway: the maintained stable line (1.30.x; nginx.org stable since April 2026), unprivileged image (uid 101).
GATEWAY_IMAGE=ghcr.io/nginx/nginx-unprivileged:1.30.5-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
# Valhalla, also used for data-fetch, valhalla-build and build-info (has curl + python3).
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla:3.9.0@sha256:511c095b8caf393dccceb8b519ec96b6f85a0166b2288ba014a8a748acc5a63c
# Java 21 JDK for Photon and the Protomaps/Planetiler build. MCR publishes no patch tags; the digest pins Microsoft
# Build of OpenJDK 21.0.12.1 (Ubuntu base of 2026-10-09).
JAVA_BASE_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu@sha256:1f8b75e6a48bfb5bb4e6b367dac83b52b42f6e9d33570ca44e88ba8fd92a6321
# go-pmtiles CLI, used only by `make tiles-info`.
PMTILES_IMAGE=ghcr.io/protomaps/go-pmtiles:v1.31.2@sha256:06574f01f55a78f78f887bc7ebf729a5c093c0d6e17d9876300cfcb0758b59d3

# ---------------------------------------------------------------- Container limits (SEC-4A BE-4; sized for the 16 GB staging host)
# Memory limit of each Valhalla service lane (graph tar mapped from disk; measured about 0.1 GB in dev, 4 threads).
VALHALLA_MEM_LIMIT=2g
# Memory limit of each Photon lane: PHOTON_JAVA_OPTS -Xmx1g + embedded OpenSearch off-heap. Raise with -Xmx.
PHOTON_MEM_LIMIT=2g
# Memory limit of the one-shot tiles build: TILES_JAVA_OPTS -Xmx3g + Maven + Planetiler off-heap. Raise with -Xmx.
TILES_BUILD_MEM_LIMIT=6g
# Memory limit of the one-shot Valhalla graph build (all three builders together peaked at 4.5 GB, RUNBOOK §17).
VALHALLA_BUILD_MEM_LIMIT=4g
# Memory limit of the one-shot Photon import (import -Xmx1g + the zstd decoder JVM + OpenSearch).
PHOTON_IMPORT_MEM_LIMIT=3g

# ---------------------------------------------------------------- Valhalla service
# Worker threads for valhalla_service (empty = all CPUs).
VALHALLA_THREADS=
# Valhalla per-request processing timeout in seconds (1-9, below the 10 s gateway timeout) -> 504 UpstreamTimeout.
VALHALLA_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------- Gateway
# Host interface the gateway binds to (127.0.0.1 = this machine only; 0.0.0.0 = LAN, e.g. phone testing).
GATEWAY_BIND=127.0.0.1
# Host port of the gateway (change it if 8080 is taken).
GATEWAY_PORT=8080
# Allowed CORS origins: `*` (any origin, local dev only) or a comma-separated list such as http://localhost:5173.
CORS_ALLOWED_ORIGINS=*
# nginx error_log level. `crit` keeps request lines (which contain coordinates/search text) out of the logs.
GATEWAY_ERROR_LOG_LEVEL=crit
# Per-client rate limits on /v1/route and on /v1/search + /v1/reverse (NAV-008 AC 13): `off` (dev default)
# or `on` (staging; infra/staging/compose.staging.yaml forces on). /health, tiles and OPTIONS are never request-limited.
# Client = IPv4 address or IPv6 /64 prefix (SEC-4A BE-2). `on` also enables the SEC-4A download limits below.
GATEWAY_RATE_LIMIT=off
# Requests per second per client IP for /v1/route (format <n>r/s; 429 responses carry Retry-After: 1).
GATEWAY_RATE_ROUTE=30r/s
# Extra requests per client IP allowed above the rate for /v1/route, answered without delay.
GATEWAY_BURST_ROUTE=60
# Requests per second per client IP for /v1/search and /v1/reverse together (one shared zone).
GATEWAY_RATE_SEARCH=30r/s
# Burst for /v1/search and /v1/reverse together.
GATEWAY_BURST_SEARCH=60
# NAV-020: per-client-IP rate limit for /packs/ (offline pack manifest + files, own zone; <n>r/s). Only with
# GATEWAY_RATE_LIMIT=on and only in the slot runtime (compose.slots.yaml); the dev stack serves no packs (404).
GATEWAY_RATE_PACKS=2r/s
# Burst above the packs rate, answered without delay.
GATEWAY_BURST_PACKS=20
# Max /v1/route requests in flight in total; over it -> 503 RoutingBusy (2 x VALHALLA_THREADS; tune on staging).
GATEWAY_ROUTE_MAX_INFLIGHT=8
# Max /v1/route requests in flight per client IP; over it -> 503 RoutingBusy.
GATEWAY_ROUTE_MAX_INFLIGHT_PER_IP=4
# SEC-4A BE-3 download limits, only with GATEWAY_RATE_LIMIT=on (values and meaning: infra/staging/.env.example).
# Pack file (.gz) downloads in flight per client (IPv4 address / IPv6 /64); over it -> 429 RateLimited.
GATEWAY_PACKS_MAX_CONN_PER_IP=2
# Pack file downloads in flight from all clients together; over it -> 429 RateLimited (manifest.json is not counted).
GATEWAY_PACKS_MAX_CONN=64
# Bytes of every /packs/ response sent at full speed before GATEWAY_PACKS_LIMIT_RATE applies (nginx size, k/m).
GATEWAY_PACKS_LIMIT_RATE_AFTER=10m
# Bytes per second per /packs/ response after that (0 = no bandwidth limit).
GATEWAY_PACKS_LIMIT_RATE=2m
# Bytes of every tiles response sent at full speed (PMTiles range reads stay below it).
GATEWAY_TILES_LIMIT_RATE_AFTER=4m
# Bytes per second per tiles response after that (0 = no bandwidth limit).
GATEWAY_TILES_LIMIT_RATE=1m
# Tiles requests in flight per client; 0 = off (the contract keeps tiles unlimited).
GATEWAY_TILES_MAX_CONN_PER_IP=0
# Comma-separated CIDRs of a reverse proxy whose X-Forwarded-For is trusted as the client IP. Empty (dev) = none.
# Staging derives it from the Caddy address in infra/staging/.env; do not set it by hand there.
GATEWAY_REAL_IP_FROM=

# ---------------------------------------------------------------- Network for the data build
# Optional PEM file with extra CA certificates for build downloads (TLS-intercepting corporate proxy). Empty file = none.
EXTRA_CA_CERT=./config/empty-ca.pem
# Optional outbound proxy for build downloads (curl and Maven), e.g. http://proxy.example:3128. Empty = direct.
BUILD_HTTPS_PROXY=

# ---------------------------------------------------------------- Daily rebuild pipeline (NAV-006; optional here)
# The pipeline's own keys (NAV_DATA_ROOT, OSM_SOURCES, REBUILD_*) are listed in infra/staging/.env.example and
# pipeline/nav006-test.env.template. These four are optional everywhere; the defaults are shown.
# Optional: User-Agent sent on every source request (AC 2). Default (empty) = the pipeline's descriptive NAV-006 UA.
# REBUILD_USER_AGENT="nav-mn-rebuild/2 (NAV-006; +https://www.openstreetmap.org/copyright; daily, at most one download per day)"
# Optional: systemd timer whose next run "make status" reports as next_scheduled_run. Default nav-rebuild.timer.
# NAV_TIMER_UNIT=nav-rebuild.timer
# Optional: absolute path of a Python with jsonschema + PyYAML for the contract check.
# Default (empty) = backend/.venv/bin/python if it exists (make contract creates it), else the pipeline's own Python.
# CONTRACT_PYTHON=
# NAV-020 offline pack keys (PACK_ENABLED, PACK_*_AGE_DAYS, PACK_MIN_FREE_GB, PACK_GATE2_*, PACK_METHOD_URL, ...)
# belong to the pipeline config: infra/staging/.env.example (staging) and pipeline/nav020-test.env.template (test).
# ONE-TIME staging migration only (infra/staging/RUNBOOK.md 7.9 step 5, on the command line): 1 = accept a project
# that still has containers from compose.yaml. Default 0 = refuse (protects the dev stack). Never set it for dev.
# NAV_ALLOW_LEGACY_PROJECT=0
