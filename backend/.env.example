# NAV-001 local dev stack. Copy to .env (`cp .env.example .env`) and edit.
# Every key is optional: compose.yaml has the same defaults. No secrets belong in this file.
# Relative paths are relative to backend/ (the directory that holds compose.yaml).

# ---------------------------------------------------------------- OSM source (tiles + routing)
# OSM extract to download (NAV-001 AC 3, ADR-0002 Amendment 1).
# Dev default: full Mongolia extract (~70 MB) from geo2day.com, a third-party mirror. DEV ONLY:
# download.geofabrik.de is blocked from the dev container. No availability or integrity guarantee;
# data/build-info.json records its sha256, HTTP Last-Modified and bbox. Use OSM_PBF_FILE when it is down.
OSM_PBF_URL=https://geo2day.com/asia/mongolia.pbf
# Production value (all of Mongolia, Geofabrik, carries a header bbox and replication timestamp):
# OSM_PBF_URL=https://download.geofabrik.de/asia/mongolia-latest.osm.pbf
# Optional small/fast alternative, NOT the default: BBBike Ulaanbaatar box (~4.4 MB, ~13 x 4 km).
# It misses reference points P3 Zaisan and P6 Chingeltei, so NAV-001 AC 10/13/14 fail on it.
# OSM_PBF_URL=https://download.bbbike.org/osm/bbbike/UlanBator/UlanBator.osm.pbf
# Optional local PBF file. When set, it is used instead of OSM_PBF_URL and no request is made to the URL.
OSM_PBF_FILE=

# ---------------------------------------------------------------- Photon search index (ADR-0003)
# Photon JSON dump to import (GraphHopper weekly Mongolia dump, .jsonl.zst or plain .jsonl).
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/asia/mongolia/photon-dump-mongolia-1.0-latest.jsonl.zst
# Optional local dump file. When set, it is used instead of PHOTON_DUMP_URL and no request is made to the URL.
PHOTON_DUMP_FILE=
# Languages extracted into the index; `lang` accepts only these plus `default`.
PHOTON_LANGUAGES=mn,en,ru
# Optional country filter for the import (comma-separated ISO codes, empty = everything in the dump).
PHOTON_COUNTRY_CODES=
# Language used when a request has no `lang` and no Accept-Language.
PHOTON_DEFAULT_LANGUAGE=mn
# Upper bound for the `limit` parameter.
PHOTON_MAX_RESULTS=20
# JVM options for photon import and serve (heap).
PHOTON_JAVA_OPTS=-Xms256m -Xmx1g

# ---------------------------------------------------------------- Planetiler auxiliary sources (Protomaps basemap)
# Downloaded once into data/sources/ and reused. A file already present there is used without any request.
# Natural Earth vector GeoPackage (public domain, ~446 MB).
NATURAL_EARTH_URL=https://naciscdn.org/naturalearth/packages/natural_earth_vector.gpkg.zip
# OSM water polygons, split, EPSG:3857 (ODbL, ~931 MB).
WATER_POLYGONS_URL=https://osmdata.openstreetmap.de/download/water-polygons-split-3857.zip
# OSM land polygons, split, EPSG:3857 (ODbL, ~952 MB).
LAND_POLYGONS_URL=https://osmdata.openstreetmap.de/download/land-polygons-split-3857.zip
# Daylight landcover GeoPackage hosted by Protomaps (~36 MB).
LANDCOVER_URL=https://r2-public.protomaps.com/datasets/daylight-landcover.gpkg
# Wikidata QRank popularity scores used for label ranking (CC0, ~106 MB).
QRANK_URL=https://qrank.toolforge.org/download/qrank.csv.gz
# Pre-shaped glyph encoding used for complex scripts (~0.8 MB).
PGF_ENCODING_URL=https://wipfli.github.io/pgf-encoding/pgf-encoding.zip

# ---------------------------------------------------------------- Tile build
# Highest zoom level in the PMTiles archive (Protomaps default 15, story needs >= 14).
TILES_MAXZOOM=15
# Optional bounds minLon,minLat,maxLon,maxLat. Empty = bbox from the PBF header.
TILES_BOUNDS=
# JVM options for the Planetiler run (heap).
TILES_JAVA_OPTS=-Xmx3g
# Worker threads for Planetiler and the Valhalla graph build (empty = all CPUs).
BUILD_THREADS=

# ---------------------------------------------------------------- Tool downloads (pinned, checksum verified)
# Photon release jar and its sha256.
PHOTON_JAR_URL=https://github.com/komoot/photon/releases/download/1.3.0/photon-1.3.0.jar
PHOTON_JAR_SHA256=a89707c0045e4807b2a1180e132e68e108d998709f48b6c94b98a6e281f571a5
# Pure-Java zstd decoder used to stream the .zst Photon dump into the import (Maven Central) and its sha256.
AIRCOMPRESSOR_URL=https://repo1.maven.org/maven2/io/airlift/aircompressor/0.27/aircompressor-0.27.jar
AIRCOMPRESSOR_SHA256=fdbef3137a28f63bb0cb93487803080ede746a4ec3d421e36c6f0c305c35e5e4
# Protomaps basemap git commit (Tiles 4.15.2, Planetiler 0.10.2).
PROTOMAPS_COMMIT=42ffaaa4a85a41bfcb23e43cc0f5b492a5eca123
# Source tarball of that commit (codeload.github.com).
PROTOMAPS_SRC_URL=https://codeload.github.com/protomaps/basemaps/tar.gz/42ffaaa4a85a41bfcb23e43cc0f5b492a5eca123
# sha256 of the Protomaps source tarball.
PROTOMAPS_SRC_SHA256=f89ff8ee6aff13baf60c83b5e98d3811ddb946cc1089d437c435885395764696
# Maven binary distribution used once to build the Protomaps jar, and its sha512.
MAVEN_DIST_URL=https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.9.11/apache-maven-3.9.11-bin.tar.gz
MAVEN_DIST_SHA512=bcfe4fe305c962ace56ac7b5fc7a08b87d5abd8b7e89027ab251069faebee516b0ded8961445d6d91ec1985dfe30f8153268843c89aa392733d1a3ec956c9978

# ---------------------------------------------------------------- Images (pinned; override to use a mirror or a local build)
# nginx gateway (ghcr has 1.27.4 as newest; nginxinc/nginx-unprivileged:1.28-alpine on Docker Hub also works).
GATEWAY_IMAGE=ghcr.io/nginxinc/nginx-unprivileged:1.27.4-alpine
# Valhalla, also used for data-fetch, valhalla-build and build-info (has curl + python3).
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla:3.9.0@sha256:511c095b8caf393dccceb8b519ec96b6f85a0166b2288ba014a8a748acc5a63c
# Java 21 JDK for Photon and the Protomaps/Planetiler build.
JAVA_BASE_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
# go-pmtiles CLI, used only by `make tiles-info`.
PMTILES_IMAGE=ghcr.io/protomaps/go-pmtiles:v1.31.2

# ---------------------------------------------------------------- Valhalla service
# Worker threads for valhalla_service (empty = all CPUs).
VALHALLA_THREADS=

# ---------------------------------------------------------------- Gateway
# Host interface the gateway binds to (127.0.0.1 = this machine only; 0.0.0.0 = LAN, e.g. phone testing).
GATEWAY_BIND=127.0.0.1
# Host port of the gateway (change it if 8080 is taken).
GATEWAY_PORT=8080
# Allowed CORS origins: `*` (any origin, local dev only) or a comma-separated list such as http://localhost:5173.
CORS_ALLOWED_ORIGINS=*
# nginx error_log level. `crit` keeps request lines (which contain coordinates/search text) out of the logs.
GATEWAY_ERROR_LOG_LEVEL=crit

# ---------------------------------------------------------------- Network for the data build
# Optional PEM file with extra CA certificates for build downloads (TLS-intercepting corporate proxy). Empty file = none.
EXTRA_CA_CERT=./config/empty-ca.pem
# Optional outbound proxy for build downloads (curl and Maven), e.g. http://proxy.example:3128. Empty = direct.
BUILD_HTTPS_PROXY=
