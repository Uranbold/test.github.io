# NAV-008 ops VM configuration (deployment-staging.md §9, §17.4). Copy to .env IN THE SAME DIRECTORY as compose.yaml
# on the ops VM and fill in:   cp .env.example .env && chmod 600 .env
# docker compose reads it automatically from the compose file's directory. Never commit the real file (git-ignored).
# No IP addresses here: DNS points OPS_HOST at the VM.

# Public DNS name of the ops VM (e.g. ops-staging.<domain>, an A/AAAA record in the company zone). Caddy gets a
# Let's Encrypt certificate for it, and the staging host's push URLs start with https://<OPS_HOST>/api/push/.
# Must equal OPS_HOST in infra/staging/.env on the staging host. Bare host name: no scheme, port or path.
OPS_HOST=ops-staging.example.invalid
# Let's Encrypt contact: a company ROLE mailbox (not a personal address).
ACME_EMAIL=ops@example.invalid
# ACME directory. Production Let's Encrypt; set the LE staging CA only for a test run.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Caddy image pinned by digest (Apache-2.0); keep it equal to CADDY_IMAGE on the staging host.
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
# Uptime Kuma image pinned by digest (MIT).
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.5.5-slim@sha256:9c56a772a7df53f444a404c579e87a27bd0c201375d00d6745a75bf8138f4342
# Host ports Caddy publishes (TCP). Keep 80/443 on the VM (ACME HTTP-01 needs 80); other values are for local tests.
OPS_HTTP_PORT=80
# HTTPS port, see OPS_HTTP_PORT.
OPS_HTTPS_PORT=443
