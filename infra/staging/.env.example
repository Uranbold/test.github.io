# NAV-008 staging configuration (deployment-staging.md §13). Copy to infra/staging/.env ON THE HOST and fill in.
#   cp infra/staging/.env.example infra/staging/.env && chmod 600 infra/staging/.env
# infra/staging/.env is git-ignored and is the ONLY config file the staging scripts read (bin/nav-compose passes
# it as --env-file; backend/.env is not used on staging). Keys not set here fall back to the defaults in
# backend/compose.yaml (see backend/.env.example for every backend key).
# Never commit the real file: it holds the host name, push tokens and paths to secrets. The host's IP address is
# not needed anywhere in the repository (DNS points the name at it).

# ---------------------------------------------------------------- Public names and TLS (Caddy)
# Public API host name (a subdomain of the company domain, D6). Caddy gets its certificate for it. No scheme/port.
STAGING_HOST=staging.example.invalid
# Let's Encrypt contact: a company ROLE mailbox (not a personal address).
ACME_EMAIL=ops@example.invalid
# ACME directory. Production Let's Encrypt; bin/cert-dry-run.sh uses the LE staging CA by itself.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Caddy image, pinned by digest (Apache-2.0). Change only together with a snapshot and a log check (RUNBOOK "Upgrades").
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
# Host ports Caddy publishes (TCP, IPv4 and IPv6). Keep 80/443 on the server; other values are for local tests only.
CADDY_HTTP_PORT=80
# HTTPS port, see CADDY_HTTP_PORT.
CADDY_HTTPS_PORT=443
# Reserved: web demo host name if the PO agrees that this host serves the NAV-002 build (Caddyfile block is commented).
DEMO_HOST=

# ---------------------------------------------------------------- Gateway (overrides of backend/.env.example keys)
# CORS allowlist: web demo origin(s) + local dev. NEVER '*' (deploy.sh refuses it, NAV-008 AC 11).
CORS_ALLOWED_ORIGINS=https://demo-staging.example.invalid,http://localhost:5173
# Host port of the gateway on 127.0.0.1 (only Caddy and operators on the host use it).
GATEWAY_PORT=8080
# nginx error_log level. Must stay crit on staging (error lines contain client IPs and query strings).
GATEWAY_ERROR_LOG_LEVEL=crit
# Per-client-IP rate limit for /v1/route (<n>r/s). Rate limiting itself is always on in the staging overlay.
GATEWAY_RATE_ROUTE=30r/s
# Burst above the rate for /v1/route, served without delay (100 r/s for 10 s -> about 60 + 30 x 10 accepted).
GATEWAY_BURST_ROUTE=60
# Per-client-IP rate limit for /v1/search and /v1/reverse together (one shared zone).
GATEWAY_RATE_SEARCH=30r/s
# Burst for /v1/search and /v1/reverse together.
GATEWAY_BURST_SEARCH=60

# Compose project name: prefix of containers and volumes (backups find the Caddy volumes by it). Keep navmn.
NAV_COMPOSE_PROJECT=navmn

# ---------------------------------------------------------------- Edge network (Caddy <-> gateway); change only on an address clash
# IPv4 subnet of the Compose network that only Caddy and the gateway join.
EDGE_SUBNET_V4=172.30.81.0/28
# Dynamic address range inside it (must not contain CADDY_IPV4).
EDGE_IP_RANGE_V4=172.30.81.8/29
# Caddy's fixed IPv4 address; the gateway trusts X-Forwarded-For from this address only.
CADDY_IPV4=172.30.81.2
# IPv6 on the edge network: auto (on when the host kernel has IPv6), on, or off.
EDGE_IPV6=auto
# IPv6 subnet (ULA) of the edge network, used when IPv6 is on.
EDGE_SUBNET_V6=fd4e:6176:0:81::/64
# Dynamic IPv6 range inside it (must not contain CADDY_IPV6).
EDGE_IP_RANGE_V6=fd4e:6176:0:81::1:0/112
# Caddy's fixed IPv6 address, trusted like CADDY_IPV4.
CADDY_IPV6=fd4e:6176:0:81::2

# ---------------------------------------------------------------- Daily rebuild pipeline (NAV-006, ADR-0014; RUNBOOK.md NAV-006 section)
# Slot root on the host: cache, slots, lanes, pointer, state.json, run logs. One filesystem, OUTSIDE the checkout.
NAV_DATA_ROOT=/var/lib/nav/data
# Lock shared by the rebuild, make rollback, deploy.sh and cert-dry-run.sh (kernel flock; no stale lock after kill -9).
NAV_LOCK_FILE=/run/lock/nav-stack.lock
# Host port of the private verify gateway (127.0.0.1 only, never in Caddy); used only while a new slot is checked.
NAV_VERIFY_PORT=8089
# Ordered OSM source list: https:// URLs or file:<absolute path>, space-separated; each is retried once after 30 s,
# then the next is tried. Staging: Geofabrik only (NAV-006 open question 1, working assumption (b)).
OSM_SOURCES=https://download.geofabrik.de/asia/mongolia-latest.osm.pbf
# Used only when OSM_SOURCES is empty (NAV-001 key): the single OSM source.
OSM_PBF_URL=https://download.geofabrik.de/asia/mongolia-latest.osm.pbf
# Photon dump (GraphHopper weekly Mongolia dump). Checked with HEAD; downloaded only when it changed.
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/asia/mongolia/photon-dump-mongolia-1.0-latest.jsonl.zst
# A source that sends no data for this many seconds fails (AC 2).
REBUILD_SOURCE_STALL_SECONDS=120
# Delay before the one retry of a failed source (>= 30, AC 2).
REBUILD_SOURCE_RETRY_DELAY_SECONDS=30
# Check 3(c): minimum extract size in MB (Mongolia is about 70 MB).
REBUILD_MIN_EXTRACT_MB=40
# Check 3(d): new extract >= this share of the active slot's extract (override once: make rebuild ACCEPT_SIZE_DROP=1).
REBUILD_MIN_SIZE_RATIO=0.90
# Check 3(e): 1 = the new data date must not be older than the active slot's.
REBUILD_REQUIRE_NOT_OLDER=1
# Check 3(f) and the "stale" status/alert: maximum age (hours) of the OSM data date (0 disables 3(f); stale stays 48).
REBUILD_MAX_DATA_AGE_HOURS=48
# AC 12: maximum relative distance change of the reference routes P1-P3, P1-P2, P1-P6 (override: ACCEPT_ROUTE_CHANGE=1).
REBUILD_ROUTE_MAX_DEVIATION=0.20
# AC 13: PMTiles, routing graph and Photon index each >= this share of the active slot's (override: ACCEPT_SIZE_DROP=1).
REBUILD_ARTEFACT_MIN_RATIO=0.90
# AC 27: minimum free disk (GB) on NAV_DATA_ROOT before a run starts; below it the run is "skipped: low disk".
REBUILD_MIN_FREE_GB=50
# AC 27: the build stops and the partial slot is deleted when free disk falls below this (GB) during the build.
REBUILD_HARD_FLOOR_FREE_GB=5
# AC 28: minimum MemAvailable (GB) before a run starts (5.5 GB build peak + 1 GB); below it "skipped: low memory".
REBUILD_MIN_MEM_AVAILABLE_GB=6.5
# AC 17: seconds the old lane keeps running after a switch or rollback (>= 30), then it is stopped.
REBUILD_GRACE_SECONDS=30
# Seconds a new lane may take to become healthy during verification.
REBUILD_LANE_START_TIMEOUT_SECONDS=240
# AC 18: seconds the previous lane may take to become healthy during make rollback (the whole rollback must be <= 60 s).
REBUILD_ROLLBACK_START_TIMEOUT_SECONDS=55
# AC 31: days the per-run logs in NAV_DATA_ROOT/runs are kept (>= 14). The journal keeps its own copy.
REBUILD_LOG_RETENTION_DAYS=30
# AC 32 alert hook (placeholder, empty = no-op): a shell command run once per failed, rolled-back, guard-skipped or
# stale run with NAV_RUN_ID, NAV_RUN_RESULT, NAV_RUN_STEP, NAV_RUN_REASON, NAV_RUN_EXIT_CODE. Never logged; may
# hold a token (then it is a SECRET, like the push URLs). Use single quotes.
REBUILD_ALERT_CMD=
# Timeout of the alert hook in seconds (at most 10; the hook never blocks or fails the pipeline).
REBUILD_ALERT_TIMEOUT_SECONDS=10
# URL the post-switch smoke and the "unchanged" health check use (default https://$STAGING_HOST through Caddy).
SMOKE_BASE_URL=

# ---------------------------------------------------------------- Monitoring (Uptime Kuma on the ops VM; monitoring/uptime-kuma-monitors.yaml)
# Public DNS name of the ops VM (same value as OPS_HOST in monitoring/ops-vm/.env there). Its Caddy forwards only
# /api/push/* to Uptime Kuma. When set, every UPTIME_PUSH_URL_* must start with https://<OPS_HOST>/api/push/
# (heartbeats refuse other origins, e.g. the http://localhost:3001 origin the Kuma UI shows through the SSH tunnel).
OPS_HOST=
# SECRET: push URL of the "nav-staging rebuild" push monitor (pushed after a good rebuild + smoke).
# Format: https://<OPS_HOST>/api/push/<token> (the ?status=up&msg=OK&ping= part may stay; it is rebuilt).
UPTIME_PUSH_URL_REBUILD=
# SECRET: push URL of the "nav-staging disk" push monitor (pushed every 5 min while disk use < DISK_ALERT_PERCENT).
UPTIME_PUSH_URL_DISK=
# SECRET (optional): push URL of the "nav-staging backup" push monitor (pushed after a good backup).
UPTIME_PUSH_URL_BACKUP=
# Disk usage (%) at which the disk heartbeat stops (alert after 15 min without a push).
DISK_ALERT_PERCENT=85

# ---------------------------------------------------------------- Backups (bin/nav-backup.sh, restic over SFTP to the ops VM)
# restic repository on the ops VM: sftp:nav-ops-vm:/srv/restic/nav-staging (nav-ops-vm = host alias in /root/.ssh/config).
RESTIC_REPOSITORY=
# Path of the restic repository password file: root-only (chmod 600), OUTSIDE the git checkout, never in git.
RESTIC_PASSWORD_FILE=/root/.config/nav/restic-password
# Share of pack data read by the weekly `restic check` (e.g. 10%).
RESTIC_CHECK_SUBSET=10%
# Host tag written into restic snapshots (role name, not the IP).
BACKUP_HOST_TAG=nav-staging
