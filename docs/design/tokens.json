        "outline-variant":        { "$type": "color", "$value": "#C4C7C5", "$description": "Dividers inside button groups" },
        "primary":                { "$type": "color", "$value": "#0B57D0", "$description": "Active / following state, text buttons, links on hover" },
        "on-primary":             { "$type": "color", "$value": "#FFFFFF" },
