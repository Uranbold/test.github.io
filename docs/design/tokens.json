{
  "$description": "Design tokens for the OSM Navigation product (owner: ux-designer). Format: W3C Design Tokens Community Group draft ($type/$value). Two modes: 'light' (day) and 'night'. UI colours follow Material 3 roles; map colours are complete Protomaps basemap 'Flavor' objects (@protomaps/basemaps styles, schema 4.x tiles at commit 42ffaaa4) plus a small 'custom' group applied by post-processing (see docs/design/map-style.md). This file is the single source of truth: if docs/design/map-style.md or a screen spec quotes a different value, this file wins.",
  "meta": {
    "version": "0.1.0",
    "created": "2026-09-29",
    "stories": ["NAV-002"],
    "modes": {
      "light": "Day mode («өдрийн горим» / Day mode). Default on first visit (NAV-002 AC 26).",
      "night": "Night mode («шөнийн горим» / Night mode). Glare-free: no large area lighter than #3A4452, text never pure white."
    },
    "contrastTarget": "WCAG 2.2 AA: 4.5:1 for UI text, 3:1 for icons, focus rings and control boundaries. Every text/background pair listed in 'contrastPairs' is checked by docs/design/prototypes/check-contrast.mjs."
  },

  "color": {
    "light": {
      "ui": {
        "surface":                { "$type": "color", "$value": "#FFFFFF", "$description": "Map control buttons, cards, banners (neutral)" },
