# NAV-008 staging QA settings (owner: qa-engineer). Copy to staging.local.env (git-ignored) and fill in.
# Never commit the filled file. Never put passwords or private keys here: none of the scripts needs one.

# Public API host name, a subdomain of the PO's company domain (D6). Example: staging.example.mn
STAGING_HOST=
# Base URL used by every HTTP check. Leave empty to use https://$STAGING_HOST
BASE_URL=
# Allowlisted CORS origins on staging, comma separated, exactly as in the host's CORS_ALLOWED_ORIGINS (AC 11)
ALLOWED_ORIGINS=http://localhost:5173
# Optional: the host's public IPv4 / IPv6, only for scanning before DNS exists and for the repo IP-leak scan.
# Leave empty to take the addresses from DNS. These values must never appear in any committed file.
STAGING_IPV4=
STAGING_IPV6=
# SSH port the design allows (deployment-staging.md section 4). Change only if the runbook uses another port.
SSH_PORT=22
# SSH user names probed for password refusal (no password is ever sent: BatchMode, publickey offer disabled)
SSH_PROBE_USERS=nav-ops root
